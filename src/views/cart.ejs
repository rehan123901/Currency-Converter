<%- include('partials/header') %>
<h1 class="mb-3">Your Cart</h1>
<% if (!items.length) { %>
  <div class="alert alert-info">Your cart is empty. <a href="/products">Browse products</a>.</div>
<% } else { %>
  <form method="post" action="/cart/update">
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th>Product</th>
            <th style="width: 140px;">Quantity</th>
            <th class="text-end">Price</th>
            <th class="text-end">Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function(row){ %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= row.product.image %>" alt="" style="width:60px;height:60px;object-fit:cover" class="rounded">
                  <div>
                    <div class="fw-semibold"><%= row.product.name %></div>
                    <div class="text-muted small">$<%= row.product.price.toFixed(2) %></div>
                  </div>
                </div>
              </td>
              <td>
                <input type="hidden" name="productId" value="<%= row.product.id %>">
                <input class="form-control" name="quantity" type="number" min="0" value="<%= row.quantity %>">
              </td>
              <td class="text-end">$<%= row.product.price.toFixed(2) %></td>
              <td class="text-end">$<%= row.lineTotal.toFixed(2) %></td>
              <td class="text-end">
                <form method="post" action="/cart/remove/<%= row.product.id %>">
                  <button class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="3" class="text-end">Grand total</th>
            <th class="text-end">$<%= total.toFixed(2) %></th>
            <th></th>
          </tr>
        </tfoot>
      </table>
    </div>
    <div class="d-flex justify-content-between">
      <a class="btn btn-outline-secondary" href="/products">Continue shopping</a>
      <div class="d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">Update quantities</button>
        <a class="btn btn-primary" href="/checkout">Checkout</a>
      </div>
    </div>
  </form>
<% } %>
<%- include('partials/footer') %>
