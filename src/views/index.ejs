<%- include('partials/header') %>
<section class="py-4">
  <div class="p-5 mb-4 bg-light rounded-3">
    <div class="container py-5">
      <h1 class="display-5 fw-bold">Welcome to Acme Store</h1>
      <p class="col-md-8 fs-5">Quality products at friendly prices. Browse featured items below or view all products.</p>
      <a class="btn btn-primary btn-lg" href="/products">Shop all products</a>
    </div>
  </div>

  <h2 class="mb-3">Featured</h2>
  <div class="row g-4">
    <% products.forEach(function(product){ %>
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="card product-card h-100">
          <img src="<%= product.image %>" class="card-img-top" alt="<%= product.name %>">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= product.name %></h5>
            <p class="card-text text-muted">$<%= product.price.toFixed(2) %></p>
            <div class="mt-auto d-flex gap-2">
              <a href="/products/<%= product.id %>" class="btn btn-outline-secondary w-50">View</a>
              <form method="post" action="/cart/add" class="d-flex w-50">
                <input type="hidden" name="productId" value="<%= product.id %>">
                <input type="hidden" name="quantity" value="1">
                <button class="btn btn-primary w-100" type="submit">Add</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<%- include('partials/footer') %>
