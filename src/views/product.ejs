<%- include('partials/header') %>
<div class="row g-4">
  <div class="col-md-6">
    <img src="<%= product.image %>" class="img-fluid rounded" alt="<%= product.name %>">
  </div>
  <div class="col-md-6">
    <h1><%= product.name %></h1>
    <p class="text-muted">$<%= product.price.toFixed(2) %></p>
    <p><%= product.description %></p>
    <form method="post" action="/cart/add" class="d-flex gap-2 align-items-center">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <input class="form-control" name="quantity" type="number" min="1" value="1" style="max-width: 120px;">
      <button class="btn btn-primary" type="submit">Add to cart</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
